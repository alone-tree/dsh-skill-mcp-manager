{
  "name": "dsh-skill-mcp-manager",
  "description": "能力库 (Capability) — DSH host plugin: visual, manageable, injectable Skill & MCP management. Three-tier MCP (eager / on-demand / disabled) with mcp_register / mcp_load / mcp_call tools and a pre-step MCP catalog.",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alone-tree/dsh-skill-mcp-manager.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/skill.js",
    "lib/ui.js",
    "client/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skill",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.5.0"
  }
}
