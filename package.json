{
  "name": "dsh-skill-mcp-manager",
  "description": "能力库 (Capability) — one-stop visual management of DSH Skills & MCP: on-demand MCP loading, in-session hot reload, and SKILL/MCP descriptions viewable in the plugin.",
  "version": "1.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alone-tree/dsh-skill-mcp-manager.git"
  },
  "homepage": "https://github.com/alone-tree/dsh-skill-mcp-manager",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/skill.js",
    "lib/ui.js",
    "client/client.js",
    "AGENTS.md",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml",
    "cordis.patch.example.yml",
    "docs/screenshot-mcp.png",
    "docs/screenshot-skills.png",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "capability",
    "ability-library",
    "mcp",
    "skill",
    "catalog",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.5.0"
  }
}
