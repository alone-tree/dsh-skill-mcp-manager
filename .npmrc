# The default isolated linker creates Windows junctions whose reparse points
# Node does not realpath in this environment, which breaks resolution of the
# SDK's transitive deps (ajv, which, ...) from the repo root. A hoisted, real
# directory tree avoids junctions entirely; it only affects this repo's local
# install, not the published package or the DSH profile (which uses link:).
node-linker=hoisted
